## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# .NET / Visual Studio
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
*.rsuser
*.pdb
*.cache
project.lock.json
project.fragment.lock.json

# NuGet packages
*.nupkg
*.snupkg

# ASP.NET / app config
ScaffoldingReadMe.txt
appsettings.*.json
!appsettings.json
!appsettings.Development.json.example

# Secrets & environment
.env
.env.*
!.env.example
*.local.json
secrets.json
**/secrets.json
*.pfx
*.pem
*.key
*.crt
*.cer
*.p12
id_rsa*
*.secret
*.pub
*.token

# Test / build artifacts
~$*
*~
CodeCoverage/
*.binlog
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Demo secret fixtures for testing commit protection
/demo-secret-leaks/
